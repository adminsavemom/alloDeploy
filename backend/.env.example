# AlloDeploy Backend Configuration
PORT=5000
NODE_ENV=development

# Optional GitHub Personal Access Token for live repository sync
# Generate one at https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=

# Edge Storage Directory
STORAGE_DIR=./storage

# Cloudflare Edge & DNS Automation (Optional - can also be configured via Web UI Settings)
# Generate an API Token at https://dash.cloudflare.com/profile/api-tokens (Edit zone DNS + Cache Purge)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
SERVER_PUBLIC_IP=127.0.0.1
